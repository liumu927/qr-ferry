<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 品牌区 -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="qr-ferry"
        android:textColor="@color/ink"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="光学二维码摆渡"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/modeToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:checkedButton="@id/btnModeSend"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeSend"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="发送" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeReceive"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="接收" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <LinearLayout
        android:id="@+id/sendPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 二维码显示区：MaterialCardView 卡片（18dp 圆角）。
             高度与下方控制卡 1:1 权重分配：软键盘弹出（adjustResize）时两者按比例压缩，
             控制卡（含文本框）保持可见，不会因固定高度被挤没。 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/surface_muted"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp">

            <FrameLayout
                android:id="@+id/codeStage"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/sendCodeView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="6dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="发送码显示区"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/sendPlaceholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="待发送"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 控制面板：MaterialCardView（16dp 圆角 + 1dp 描边）。
             卡片内垂直布局：「文件/文本」选项卡固定在顶部不随滚动，
             下方 ScrollView 只滚内容（LinearLayout 内 weight 生效）。 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/sendTypeToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="8dp"
                    app:checkedButton="@id/btnSendFile"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <!-- 文件在前、文本在后（与 PC 端一致），默认选中「文件」 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSendFile"
                        style="@style/Widget.Qrferry.SegButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="文件"
                        app:icon="@drawable/ic_file" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSendText"
                        style="@style/Widget.Qrferry.SegButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="文本"
                        app:icon="@drawable/ic_text" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <!-- 可滚动文本框：ScrollableEditText 在内容溢出时接管手势，
                         否则让外层 ScrollView 滚动（避免嵌套滚动冲突） -->
                    <com.qrferry.receiver.widget.ScrollableEditText
                        android:id="@+id/sendTextInput"
                        android:layout_width="match_parent"
                        android:layout_height="128dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/preview_surface"
                        android:fadeScrollbars="false"
                        android:gravity="top|start"
                        android:hint="输入要发送的文本"
                        android:inputType="textMultiLine|textCapSentences"
                        android:overScrollMode="ifContentScrolls"
                        android:padding="12dp"
                        android:scrollbarStyle="insideInset"
                        android:scrollbars="vertical"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/muted"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/sendMetaText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="0 字符"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/sendFileInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:visibility="gone"
                        android:text="未选择文件"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />

                    <!-- 允许有损优化：文本去掉括号歧义，右侧圆形叹号点击显示说明 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/sendOptimizeCheck"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="false"
                            android:text="允许有损优化"
                            android:textColor="@color/ink"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <ImageButton
                            android:id="@+id/btnOptimizeInfo"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="允许有损优化说明"
                            android:src="@drawable/ic_info"
                            android:tint="@color/muted"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- 文件模式按钮（两行）：选择文件/清空 + 开始发送；文本模式隐藏 -->
                    <LinearLayout
                        android:id="@+id/fileButtonsRow1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickFile"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="选择文件" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearSend"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="清空" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/fileButtonsRow2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStartSend"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:enabled="false"
                            app:cornerRadius="12dp"
                            android:text="开始发送" />
                    </LinearLayout>

                    <!-- 文本模式按钮（一行）：清空内容/开始发送；文件模式隐藏 -->
                    <LinearLayout
                        android:id="@+id/textButtonsRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearSendText"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="清空内容" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStartSendText"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:enabled="false"
                            app:cornerRadius="12dp"
                            android:text="开始发送" />
                    </LinearLayout>

                    <!-- 参数行 1：码制 / 帧率（ExposedDropdownMenu） -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/sendCodecLayout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="码制"
                            app:endIconMode="dropdown_menu">

                            <AutoCompleteTextView
                                android:id="@+id/sendCodecInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:padding="8dp"
                                android:textSize="14sp"
                                android:textColor="@color/ink"
                                android:textColorHint="@color/muted" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/sendFpsLayout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:hint="帧率"
                            app:endIconMode="dropdown_menu">

                            <AutoCompleteTextView
                                android:id="@+id/sendFpsInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:padding="8dp"
                                android:textSize="14sp"
                                android:textColor="@color/ink"
                                android:textColorHint="@color/muted" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- 参数行 2：帧长 / 纠错 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/sendFrameBytesLayout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="帧长"
                            app:endIconMode="dropdown_menu">

                            <AutoCompleteTextView
                                android:id="@+id/sendFrameBytesInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:padding="8dp"
                                android:textSize="14sp"
                                android:textColor="@color/ink"
                                android:textColorHint="@color/muted" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/sendEcLayout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:hint="纠错"
                            app:endIconMode="dropdown_menu">

                            <AutoCompleteTextView
                                android:id="@+id/sendEcInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:padding="8dp"
                                android:textSize="14sp"
                                android:textColor="@color/ink"
                                android:textColorHint="@color/muted" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/sendStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="未开始发送"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </ScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/receivePanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 相机预览：MaterialCardView 卡片（18dp 圆角），内部固定 360dp -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="360dp"
            app:cardBackgroundColor="@color/surface_muted"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp">

            <androidx.camera.view.PreviewView
                android:id="@+id/previewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/preview_surface" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 控制面板：MaterialCardView（16dp 圆角 + 1dp 描边），内部 ScrollView 用
             match_parent（FrameLayout 内 layout_weight 无效，0dp 会导致控制区不可见） -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/line"
            app:strokeWidth="1dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReset"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="重置" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPause"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            app:cornerRadius="12dp"
                            android:text="暂停" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/status_surface"
                        android:fontFamily="monospace"
                        android:padding="12dp"
                        android:text="初始化…"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/resultText"
                        android:layout_width="match_parent"
                        android:layout_height="112dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/preview_surface"
                        android:gravity="top|start"
                        android:hint="接收完成后显示文本或待保存文件信息"
                        android:focusable="false"
                        android:inputType="textMultiLine"
                        android:padding="12dp"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/muted"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyResult"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="复制文本"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveResult"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            app:cornerRadius="12dp"
                            android:text="保存文件"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</LinearLayout>
