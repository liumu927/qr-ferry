# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
*.spec
# 上面忽略的是 PyInstaller 由 CLI 参数自动生成的 spec；qr-ferry.spec 是手写维护的
# 打包唯一真相源（CI 与本地都跑它），必须入库。
!qr-ferry.spec

# 虚拟环境
.venv/
venv/
env/

# 测试
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/

# 系统
.DS_Store
Thumbs.db

# 运行输出
*.zip
output/

# AI 工具与会话状态（本地私有，不入库）
.omc/
.agents/
.claude/

# 本地调试/参考产物（不入库）
.playwright-mcp/
_ref_decimen/
_*.diff.txt

# Android（android/ 子工程构建产物）
**/build/
local.properties
.gradle/
*.iml
.cxx/
captures/
*.apk
*.aab
*.ap_
*.dex
